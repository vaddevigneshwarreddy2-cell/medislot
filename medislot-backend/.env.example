# Local development settings. Copy to .env (never commit .env).
DB_URL=jdbc:postgresql://localhost:5432/medislot
DB_USERNAME=medislot
DB_PASSWORD=change_me_locally

SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

DEFAULT_HOSPITAL_SEARCH_RADIUS_KM=3
MAX_ACTIVE_APPOINTMENTS=3

# Random value of at least 32 characters (see README)
JWT_SECRET=

# true = new accounts must verify an OTP. false = accounts are verified immediately.
REQUIRE_VERIFICATION=false
# SMS_PROVIDER=twilio   (do not combine with REQUIRE_VERIFICATION=false)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_DEFAULT_COUNTRY_CODE=+91

# Optional tuning
APP_TIMEZONE=Asia/Kolkata
RATE_LIMIT_ENABLED=true
DEMO_DATA_ENABLED=true