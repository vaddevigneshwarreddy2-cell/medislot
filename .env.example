# Settings for docker compose. Copy to .env next to docker-compose.yml. Never commit .env.
DB_USERNAME=medislot
DB_PASSWORD=
# At least 32 random characters, for example from the PowerShell snippet in the README.
JWT_SECRET=

# prod = no demo data. Use "demo" for a demonstration instance with the demo accounts.
APP_PROFILE=prod
HTTP_PORT=8088
# The address users type in the browser (scheme + host [+ port]).
CORS_ALLOWED_ORIGINS=http://localhost:8088

# true needs the Twilio settings below, or the backend will not start.
REQUIRE_VERIFICATION=true
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_DEFAULT_COUNTRY_CODE=+91

# First platform administrator (needed under the prod profile). Remove both after the first login.
BOOTSTRAP_SUPERADMIN_EMAIL=
BOOTSTRAP_SUPERADMIN_PASSWORD=